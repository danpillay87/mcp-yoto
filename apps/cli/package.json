{
  "name": "mcp-yoto",
  "version": "0.1.1",
  "description": "MCP server for Yoto -- connect your Yoto library to Claude, ChatGPT, Cursor and other MCP clients.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-yoto": "bin/mcp-yoto.mjs"
  },
  "files": [
