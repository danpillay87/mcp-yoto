    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.danpillay87/mcp-yoto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danpillay87/mcp-yoto.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/danpillay87/mcp-yoto#readme",
  "bugs": {
    "url": "https://github.com/danpillay87/mcp-yoto/issues"
  },
  "keywords": [
