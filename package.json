{
  "name": "mcp-yoto-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci . && tsc -b && vitest run",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version",
    "release:tag": "node --input-type=commonjs -e \"const v=require('./apps/cli/package.json').version;require('child_process').execSync('git tag v'+v,{stdio:'inherit'});console.log('Tagged v'+v)\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/cli": "3.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
